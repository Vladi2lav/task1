# Настройки портала «Итоги торгов бирж ETS и Каспий».
# Скопируйте этот файл в .env и при необходимости поменяйте значения.
# start.bat создаёт .env сам при первом запуске (со случайным секретным ключом).
# Переменные окружения системы/Docker/Vercel важнее значений из .env.
# Параметры сбора (расписание, биржи, паузы) — в scraper.toml.

# --- Django ---
# Секретный ключ: длинная случайная строка, никому не показывать.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(50))"
# В Docker можно оставить пустым — ключ создастся сам и сохранится в томе appdata.
DJANGO_SECRET_KEY=
# Режим отладки: 1 — разработка (подробные ошибки), 0 — рабочий режим
DJANGO_DEBUG=0
# Адреса, по которым открывают сайт (через запятую). Для доступа из локальной сети добавьте IP компьютера.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Полные адреса сайта для защиты форм (CSRF), если сайт открыт по домену/HTTPS: https://trades.example.kz
DJANGO_CSRF_TRUSTED_ORIGINS=
# 1 — сайт работает по HTTPS (за nginx/прокси): защищённые cookie, HSTS
DJANGO_HTTPS=0
# Дополнительно при DJANGO_HTTPS=1 (по желанию):
# DJANGO_SSL_REDIRECT=1            перенаправлять http -> https средствами Django (если не делает прокси)
# DJANGO_HSTS_SECONDS=2592000      срок HSTS, секунд (30 дней)
# DJANGO_HSTS_INCLUDE_SUBDOMAINS=0 HSTS и для поддоменов
# DJANGO_HSTS_PRELOAD=0            заявка в preload-список браузеров
# Уровень логов: DEBUG, INFO, WARNING, ERROR
DJANGO_LOG_LEVEL=INFO
# Файл логов (ротация по 5 МБ, 5 архивов). Пусто или off — только консоль.
DJANGO_LOG_FILE=logs/app.log

# --- База данных ---
# По умолчанию SQLite-файл db.sqlite3 в папке проекта.
# Другой файл SQLite:   DATABASE_URL=sqlite:///data/trades.sqlite3
# PostgreSQL:          DATABASE_URL=postgres://user:password@localhost:5432/trades
# (в Docker DATABASE_URL задаётся автоматически из POSTGRES_* ниже)
DATABASE_URL=

# --- PostgreSQL для Docker (docker-compose.yml) ---
# Используются только сервисами Docker; запуск через start.bat работает с SQLite.
# Пароль — латинские буквы и цифры (он подставляется в адрес подключения).
# Поменять пароль можно только до первого запуска (потом — удалить том: docker compose down -v).
POSTGRES_DB=trades
POSTGRES_USER=trades
POSTGRES_PASSWORD=ChangeMe2026

# --- Веб-сервер ---
# Порт портала: http://127.0.0.1:8000 (start.bat и Docker)
WEB_PORT=8000
# Адрес, на котором слушает сервер в Windows: 127.0.0.1 — только этот компьютер, 0.0.0.0 — вся локальная сеть
WEB_HOST=127.0.0.1

# --- Портал ---
# 1 — только чтение: скрыт ручной запуск сбора (для публичного демо)
PORTAL_READ_ONLY=0
# Реквизиты для юридических страниц /legal/ (пусто — в тексте останутся плейсхолдеры [ФИО владельца], [email])
SITE_OWNER=
SITE_CONTACT_EMAIL=
# Хостинг-провайдер и страна размещения серверов (для политики конфиденциальности);
# пусто — «[хостинг-провайдер]», на Vercel — «Vercel Inc. (США)»
SITE_HOSTING_PROVIDER=
# Дата редакции юридических документов, например: 14 октября 2026 г. (пусто — дата по умолчанию)
LEGAL_EDITION_DATE=
# Ссылка на репозиторий проекта
PROJECT_REPO_URL=https://github.com/Vladi2lav/task1
# Не больше стольких строк в одной выгрузке Excel
PORTAL_EXPORT_MAX_ROWS=50000

# --- Администратор (создаётся командой bootstrap, если задан логин и пароль) ---
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# --- Первый запуск ---
# 1 — при первом запуске (bootstrap) сразу собрать свежие данные с сайтов бирж (нужен интернет, несколько минут)
BOOTSTRAP_COLLECT=0
